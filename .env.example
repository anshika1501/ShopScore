# ==========================================
# ShopScore - Global Environment Configuration
# ==========================================
# Copy this file to .env in the project root:
#   cp .env.example .env

# PostgreSQL / Docker Compose Settings
POSTGRES_USER=shopscore
POSTGRES_PASSWORD=shopscore_secret
POSTGRES_DB=shopscore_dev
POSTGRES_PORT=5432

# Backend Server Settings
PORT=5000
NODE_ENV=development

# Database Connection URL (connecting to PostgreSQL container on localhost:5432)
DATABASE_URL=postgresql://shopscore:shopscore_secret@localhost:5432/shopscore_dev?schema=public

# Authentication Secrets
JWT_SECRET=super_secret_jwt_key_shopscore_dev_replace_in_prod
JWT_EXPIRES_IN=1d

# Initial Administrator Credentials (used by database seed)
INITIAL_ADMIN_EMAIL=admin@shopscore.com
INITIAL_ADMIN_PASSWORD=ChangeMe@123

# Frontend Origin for CORS
CORS_ORIGIN=http://localhost:5173

