# ==========================================
# ShopScore Backend Environment Configuration
# ==========================================
# Copy this file to backend/.env:
#   cp backend/.env.example backend/.env

PORT=5000
NODE_ENV=development

# Database Connection URL (connecting from WSL to Docker container exposed on localhost:5432)
DATABASE_URL=postgresql://shopscore:shopscore_secret@localhost:5432/shopscore_dev?schema=public

# Authentication Secrets
JWT_SECRET=super_secret_jwt_key_shopscore_dev_replace_in_prod
JWT_EXPIRES_IN=1d

# Frontend Origin for CORS
CORS_ORIGIN=http://localhost:5173
